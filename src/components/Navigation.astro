---
const navItems = [
  { href: '/news', label: 'Noticias' },
  { href: '/tutoriales', label: 'Tutoriales' },
  { href: '/herramientas', label: 'Herramientas' },
  { href: '/casos-de-uso', label: 'Casos de Uso' },
  { href: '/recursos', label: 'Recursos' },
];
---

<nav class="sticky top-0 z-50 bg-surface/95 backdrop-blur-lg border-b border-border shadow-sm">
  <div class="container">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 no-underline">
        <span class="text-2xl font-heading font-semibold">
          <span class="text-primary">WorkLess</span>
          <span class="text-accent">AI</span>
        </span>
      </a>
      
      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center space-x-8">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class="text-text-secondary hover:text-accent transition-colors duration-200 font-body no-underline"
          >
            {item.label}
          </a>
        ))}
      </div>
      
      <!-- CTA -->
      <a href="/#newsletter" class="hidden md:block btn btn-accent text-sm no-underline">
        Newsletter
      </a>
      
      <!-- Mobile Menu Button - 44x44px touch target -->
      <button 
        id="mobile-menu-button" 
        class="md:hidden text-primary p-2 -mr-2 min-w-[44px] min-h-[44px] flex items-center justify-center" 
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-surface">
    <div class="container py-4 space-y-1">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class="block py-3 px-2 text-text-secondary hover:text-accent hover:bg-surface-variant/50 transition-colors rounded-lg no-underline min-h-[44px] flex items-center"
        >
          {item.label}
        </a>
      ))}
      <a href="/#newsletter" class="block w-full btn btn-accent text-center mt-4 no-underline">
        Newsletter
      </a>
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
  });
</script>
