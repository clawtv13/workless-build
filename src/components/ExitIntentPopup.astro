---
// Exit-intent popup with lead magnet (PDF)
// Triggers when user attempts to leave (mouse exits top) OR after 30s on page
// Only shows once per session, respects localStorage if dismissed
---

<div id="exit-popup" class="exit-popup hidden" role="dialog" aria-labelledby="exit-popup-title" aria-modal="true">
  <div class="exit-popup-overlay" aria-hidden="true"></div>
  
  <div class="exit-popup-content">
    <button class="exit-popup-close" aria-label="Cerrar popup" id="close-popup">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <div class="text-center">
      <!-- Icon with gradient background -->
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-gradient-to-br from-accent/30 to-primary/30 mb-6 shadow-lg">
        <svg class="w-10 h-10 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      
      <h2 id="exit-popup-title" class="text-3xl md:text-4xl font-heading font-bold mb-4 text-primary">
        Antes de Irte...
      </h2>
      
      <p class="text-xl md:text-2xl font-semibold text-accent mb-3">
        📥 Descarga 50 Prompts Avanzados
      </p>
      
      <p class="text-base md:text-lg text-gray-300 mb-6 max-w-lg mx-auto leading-relaxed">
        Prompts probados para <strong class="text-white">marketing, legal, ventas, contenido</strong> y más. 
        Listos para usar en ChatGPT, Claude o Gemini.
      </p>
      
      <!-- Benefits list -->
      <div class="text-left max-w-md mx-auto mb-8 space-y-3">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-200 text-base">50 prompts curados por expertos</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-200 text-base">Organizados por caso de uso</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-200 text-base">PDF de 18 páginas (descarga inmediata)</span>
        </div>
      </div>
      
      <form class="newsletter-form-popup" id="popup-form">
        <label for="popup-email" class="sr-only">Correo electrónico</label>
        <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input 
            id="popup-email"
            type="email" 
            name="email"
            placeholder="tu@email.com" 
            required
            aria-required="true"
            autocomplete="email"
            class="flex-1 px-5 py-3.5 rounded-lg bg-surface text-text-primary border-2 border-border focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-all text-base"
          />
          <button 
            type="submit" 
            class="btn btn-accent px-8 py-3.5 whitespace-nowrap font-bold text-base shadow-lg hover:shadow-xl" 
          >
            Descargar Gratis
          </button>
        </div>
      </form>
      
      <div class="flex items-center justify-center gap-4 mt-5 text-sm text-gray-400">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Sin spam
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Cancela cuando quieras
        </span>
      </div>
      
      <p class="text-xs text-gray-500 mt-4">
        También recibirás nuestro análisis semanal de IA (opcional)
      </p>
    </div>
  </div>
</div>

<style>
  .exit-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: fadeIn 0.3s ease-out;
  }
  
  .exit-popup.hidden {
    display: none;
  }
  
  .exit-popup-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
  }
  
  .exit-popup-content {
    position: relative;
    background: linear-gradient(to bottom, #0D111C, #1a1f2e);
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    max-width: 650px;
    width: 100%;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.5);
    animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(102, 126, 234, 0.2);
  }
  
  .exit-popup-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: #9ca3af;
    cursor: pointer;
    transition: all 0.2s;
    padding: 0.5rem;
    border-radius: 0.5rem;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .exit-popup-close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  @keyframes slideUp {
    from {
      transform: translateY(40px) scale(0.96);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }
  
  @media (max-width: 640px) {
    .exit-popup-content {
      padding: 2.5rem 1.5rem;
      max-width: 95%;
    }
    
    .newsletter-form-popup {
      flex-direction: column;
    }
    
    .newsletter-form-popup button {
      width: 100%;
    }
  }
</style>

<script>
  // Exit intent + time-based trigger with localStorage persistence
  let popupShown = false;
  const STORAGE_KEY = 'workless-exit-popup-dismissed';
  const TRIGGER_DELAY = 30000; // 30 seconds
  
  // Check if user permanently dismissed popup
  if (localStorage.getItem(STORAGE_KEY)) {
    popupShown = true;
  }
  
  // Check if popup was shown this session
  if (sessionStorage.getItem('popup-shown-this-session')) {
    popupShown = true;
  }
  
  const popup = document.getElementById('exit-popup');
  const closeBtn = document.getElementById('close-popup');
  const form = document.getElementById('popup-form') as HTMLFormElement;
  const overlay = document.querySelector('.exit-popup-overlay');
  
  function showPopup() {
    if (!popupShown && popup) {
      popup.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      popupShown = true;
      sessionStorage.setItem('popup-shown-this-session', 'true');
    }
  }
  
  function hidePopup(permanent = false) {
    if (popup) {
      popup.classList.add('hidden');
      document.body.style.overflow = '';
      
      if (permanent) {
        localStorage.setItem(STORAGE_KEY, 'true');
      }
    }
  }
  
  // Exit intent detection - mouse leaves viewport from top
  document.addEventListener('mouseleave', (e) => {
    if (e.clientY <= 0 && !popupShown) {
      showPopup();
    }
  });
  
  // Time-based trigger (30s after page load)
  setTimeout(() => {
    if (!popupShown) {
      showPopup();
    }
  }, TRIGGER_DELAY);
  
  // Close popup on button click (permanent dismiss)
  closeBtn?.addEventListener('click', () => hidePopup(true));
  
  // Close popup on overlay click (temporary)
  overlay?.addEventListener('click', () => hidePopup(false));
  
  // Close popup on ESC key (temporary)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !popup?.classList.contains('hidden')) {
      hidePopup(false);
    }
  });
  
  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    
    if (!emailInput || !submitButton) return;
    
    const email = emailInput.value;
    const originalButtonText = submitButton.textContent;
    
    // Visual feedback
    submitButton.disabled = true;
    submitButton.textContent = 'Enviando...';
    submitButton.classList.add('opacity-70');
    
    try {
      // TODO: Replace with actual email service integration (Convertkit, Mailchimp, etc.)
      // For now, just simulate API call
      await new Promise(resolve => setTimeout(resolve, 1000));
      
      // Success state
      submitButton.textContent = '✓ ¡Descarga tu PDF!';
      submitButton.classList.remove('opacity-70');
      submitButton.classList.add('bg-green-600', 'hover:bg-green-700');
      
      // TODO: Trigger PDF download
      // window.location.href = '/downloads/50-prompts-avanzados.pdf';
      
      // Close popup after success and mark as permanently dismissed
      setTimeout(() => {
        hidePopup(true);
      }, 2000);
      
      console.log('Lead magnet signup:', email);
      
    } catch (error) {
      // Error state
      submitButton.textContent = 'Error - Reintentar';
      submitButton.classList.remove('opacity-70');
      submitButton.classList.add('bg-red-600', 'hover:bg-red-700');
      
      setTimeout(() => {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
        submitButton.classList.remove('bg-red-600', 'hover:bg-red-700');
      }, 3000);
      
      console.error('Lead magnet signup error:', error);
    }
  });
</script>
