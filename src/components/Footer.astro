---
const currentYear = new Date().getFullYear();

const links = {
  navegacion: [
    { href: '/news', label: 'Noticias' },
    { href: '/tutoriales', label: 'Tutoriales' },
    { href: '/herramientas', label: 'Herramientas' },
    { href: '/casos-de-uso', label: 'Casos de Uso' },
  ],
  legal: [
    { href: '/sobre', label: 'Sobre Nosotros' },
    { href: '/recursos', label: 'Recursos' },
    { href: '/contacto', label: 'Contacto' },
  ],
  social: [
    { href: 'https://twitter.com/worklessai', label: 'Twitter', icon: 'twitter' },
    { href: 'https://linkedin.com/company/worklessai', label: 'LinkedIn', icon: 'linkedin' },
    { href: 'https://github.com/worklessai', label: 'GitHub', icon: 'github' },
  ],
};
---

<footer class="bg-surface-variant border-t border-border mt-20">
  <div class="container py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/" class="inline-block mb-4 no-underline">
          <span class="text-2xl font-heading font-semibold">
            <span class="text-primary">WorkLess</span>
            <span class="text-accent">AI</span>
          </span>
        </a>
        <p class="text-text-secondary mb-4">
          La fuente definitiva de IA en español. News, tutoriales, reviews y casos de uso actualizados diariamente.
        </p>
        <div class="flex space-x-4">
          {links.social.map(item => (
            <a 
              href={item.href} 
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-secondary hover:text-accent transition-colors no-underline"
              aria-label={item.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                {item.icon === 'twitter' && (
                  <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z" />
                )}
                {item.icon === 'linkedin' && (
                  <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z" />
                )}
                {item.icon === 'github' && (
                  <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
                )}
              </svg>
            </a>
          ))}
        </div>
      </div>
      
      <!-- Links Navegación -->
      <div>
        <h3 class="font-heading font-semibold text-primary mb-4">Navegación</h3>
        <ul class="space-y-2">
          {links.navegacion.map(item => (
            <li>
              <a href={item.href} class="text-text-secondary hover:text-accent transition-colors no-underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Links Legal -->
      <div>
        <h3 class="font-heading font-semibold text-primary mb-4">Información</h3>
        <ul class="space-y-2">
          {links.legal.map(item => (
            <li>
              <a href={item.href} class="text-text-secondary hover:text-accent transition-colors no-underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-border text-center text-text-tertiary text-sm">
      <p>&copy; {currentYear} WorkLess AI. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
