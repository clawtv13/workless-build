---
// Newsletter component - High-converting signup
// Can be used in multiple places: homepage, article end, footer
interface Props {
  variant?: 'default' | 'inline' | 'compact';
  headline?: string;
  description?: string;
}

const { 
  variant = 'default',
  headline = 'No te pierdas nada',
  description = 'Noticias de IA semanales + recursos exclusivos directamente en tu bandeja'
} = Astro.props;

const isDefault = variant === 'default';
const isInline = variant === 'inline';
const isCompact = variant === 'compact';
---

<div class={`newsletter-signup ${variant}`}>
  {isDefault && (
    <section class="py-20 bg-gradient-to-br from-primary to-primary/90 text-primary-fg">
      <div class="container">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-heading font-semibold mb-4">
            {headline}
          </h2>
          <p class="text-xl text-primary-fg/90 mb-8 leading-relaxed">
            {description}
          </p>
          <form class="newsletter-form flex flex-col sm:flex-row gap-4" aria-label="Formulario de suscripción al newsletter">
            <label for="newsletter-email" class="sr-only">Correo electrónico</label>
            <input 
              id="newsletter-email"
              type="email" 
              name="email"
              placeholder="tu@email.com" 
              required
              aria-required="true"
              autocomplete="email"
              class="flex-1 px-6 py-4 rounded-lg bg-surface text-text-primary border-2 border-transparent focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-all text-lg"
            />
            <button 
              type="submit" 
              class="btn btn-accent text-lg px-8 py-4 whitespace-nowrap font-semibold shadow-xl hover:shadow-2xl transition-all hover:scale-[1.02]" 
              aria-label="Suscribirse al newsletter"
            >
              Suscribirme Gratis
            </button>
          </form>
          <div class="flex items-center justify-center gap-6 mt-6 text-sm text-primary-fg/70">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Sin spam
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Cancela cuando quieras
            </span>
          </div>
        </div>
      </div>
    </section>
  )}

  {isInline && (
    <div class="my-12 p-8 bg-gradient-to-br from-accent/10 to-accent/5 rounded-2xl border-2 border-accent/20">
      <div class="max-w-xl mx-auto text-center">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-accent/20 mb-4">
          <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-2xl md:text-3xl font-heading font-semibold mb-3 text-primary">
          {headline}
        </h3>
        <p class="text-base text-text-secondary mb-6">
          {description}
        </p>
        <form class="newsletter-form flex flex-col sm:flex-row gap-3" aria-label="Formulario de suscripción">
          <label for="newsletter-inline-email" class="sr-only">Correo electrónico</label>
          <input 
            id="newsletter-inline-email"
            type="email" 
            name="email"
            placeholder="tu@email.com" 
            required
            aria-required="true"
            autocomplete="email"
            class="flex-1 px-5 py-3 rounded-lg bg-surface text-text-primary border-2 border-border focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-all"
          />
          <button 
            type="submit" 
            class="btn btn-accent px-6 py-3 whitespace-nowrap font-semibold" 
            aria-label="Suscribirse"
          >
            Suscribirme
          </button>
        </form>
        <p class="text-xs text-text-tertiary mt-3">
          Sin spam · Cancela cuando quieras
        </p>
      </div>
    </div>
  )}

  {isCompact && (
    <div class="my-8 p-6 bg-surface-variant rounded-xl border border-border">
      <h4 class="text-lg font-heading font-semibold mb-2 text-primary">
        {headline}
      </h4>
      <p class="text-sm text-text-secondary mb-4">
        {description}
      </p>
      <form class="newsletter-form flex gap-2" aria-label="Formulario de suscripción">
        <label for="newsletter-compact-email" class="sr-only">Correo electrónico</label>
        <input 
          id="newsletter-compact-email"
          type="email" 
          name="email"
          placeholder="tu@email.com" 
          required
          aria-required="true"
          autocomplete="email"
          class="flex-1 px-4 py-2 rounded-lg bg-surface text-text-primary border border-border focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-all text-sm"
        />
        <button 
          type="submit" 
          class="btn btn-accent px-5 py-2 text-sm whitespace-nowrap font-medium" 
          aria-label="Suscribirse"
        >
          Suscribir
        </button>
      </form>
      <p class="text-xs text-text-tertiary mt-2">
        Sin spam · Cancela siempre
      </p>
    </div>
  )}
</div>

<script>
  // Handle newsletter form submission
  document.querySelectorAll('.newsletter-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formElement = e.target as HTMLFormElement;
      const emailInput = formElement.querySelector('input[type="email"]') as HTMLInputElement;
      const submitButton = formElement.querySelector('button[type="submit"]') as HTMLButtonElement;
      
      if (!emailInput || !submitButton) return;
      
      const email = emailInput.value;
      const originalButtonText = submitButton.textContent;
      
      // Visual feedback
      submitButton.disabled = true;
      submitButton.textContent = 'Suscribiendo...';
      submitButton.classList.add('opacity-70');
      
      try {
        // TODO: Replace with actual email service integration
        // For now, just simulate success
        await new Promise(resolve => setTimeout(resolve, 1000));
        
        // Success state
        submitButton.textContent = '✓ ¡Suscrito!';
        submitButton.classList.add('bg-green-600', 'hover:bg-green-700');
        emailInput.value = '';
        
        // Reset after 3 seconds
        setTimeout(() => {
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
          submitButton.classList.remove('opacity-70', 'bg-green-600', 'hover:bg-green-700');
        }, 3000);
        
        // Log for now (remove in production)
        console.log('Newsletter signup:', email);
        
      } catch (error) {
        // Error state
        submitButton.textContent = 'Error - Inténtalo de nuevo';
        submitButton.classList.add('bg-red-600', 'hover:bg-red-700');
        
        setTimeout(() => {
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
          submitButton.classList.remove('opacity-70', 'bg-red-600', 'hover:bg-red-700');
        }, 3000);
        
        console.error('Newsletter signup error:', error);
      }
    });
  });
</script>

<style>
  .newsletter-signup {
    width: 100%;
  }
  
  .newsletter-form input[type="email"] {
    min-width: 0; /* Prevent flex item overflow */
  }
  
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .newsletter-form {
      flex-direction: column;
    }
    
    .newsletter-form button {
      width: 100%;
    }
  }
</style>
