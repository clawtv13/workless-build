---
interface Props {
  title: string;
  excerpt: string;
  href: string;
  date?: string;
  category?: string;
  image?: string;
}

const { title, excerpt, href, date, category, image } = Astro.props;
---

<article class="card group" aria-labelledby={`article-title-${title.replace(/\s+/g, '-').toLowerCase()}`}>
  {image && (
    <a href={href} class="block mb-3 md:mb-4 overflow-hidden rounded-lg aspect-video" tabindex="-1" aria-hidden="true">
      <img 
        src={image} 
        alt=""
        class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  
  <div class="flex flex-wrap items-center gap-2 md:gap-3 mb-2 md:mb-3 text-sm">
    {category && (
      <span class="inline-flex items-center px-2.5 md:px-3 py-1 rounded-full text-xs font-body font-medium bg-accent/10 text-accent">
        {category}
      </span>
    )}
    {date && (
      <time class="text-text-tertiary text-xs md:text-sm" datetime={date}>{date}</time>
    )}
  </div>
  
  <h3 id={`article-title-${title.replace(/\s+/g, '-').toLowerCase()}`} class="text-lg md:text-xl font-heading font-semibold mb-2 md:mb-3 leading-snug">
    <a href={href} class="hover:text-accent transition-colors no-underline" aria-label={`Leer artículo: ${title}`}>
      {title}
    </a>
  </h3>
  
  <p class="text-text-secondary mb-3 md:mb-4 line-clamp-2 text-sm md:text-base leading-relaxed">
    {excerpt}
  </p>
  
  <a 
    href={href} 
    class="inline-flex items-center text-accent hover:text-accent-hover transition-colors font-body font-medium text-sm no-underline min-h-[44px] py-2"
  >
    Leer más
    <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </a>
</article>
