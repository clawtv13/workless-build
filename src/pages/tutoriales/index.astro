---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Card from '../../components/Card.astro';

const allTutorials = await getCollection('tutoriales');
const sortedTutorials = allTutorials.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const difficulties = ['principiante', 'intermedio', 'avanzado'];
---

<BaseLayout title="Tutoriales IA" description="Guías prácticas paso a paso para dominar la Inteligencia Artificial">
  <Navigation />
  
  <main class="py-12">
    <div class="container">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">📚 Tutoriales IA</h1>
        <p class="text-xl text-gray-400">
          Guías prácticas paso a paso para dominar la Inteligencia Artificial
        </p>
      </div>
      
      <!-- Category Filter -->
      <div class="flex flex-wrap gap-3 mb-12">
        <button class="px-4 py-2 rounded-lg bg-primary text-dark font-medium">
          Todas
        </button>
        {difficulties.map(diff => (
          <button class="px-4 py-2 rounded-lg bg-dark border border-gray-700 hover:border-primary transition-colors capitalize">
            {diff}
          </button>
        ))}
      </div>
      
      <!-- News Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedTutorials.map(post => (
          <Card
            title={post.data.title}
            excerpt={post.data.description}
            href={`/tutoriales/${post.slug}`}
            date={post.data.date.toLocaleDateString('es-ES')}
            category={`Tutorial • ${post.data.difficulty}`}
            image={post.data.image}
          />
        ))}
      </div>
      
      {sortedTutorials.length === 0 && (
        <div class="text-center py-20">
          <p class="text-gray-400 text-lg">
            Aún no hay tutoriales publicados. ¡Vuelve pronto!
          </p>
        </div>
      )}
    </div>
  </main>
  
  <Footer />
</BaseLayout>
