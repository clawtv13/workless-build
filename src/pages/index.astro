---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';

// Import PILAR images as Astro assets
import guiaIaEspana from '/public/images/pilars/guia-ia-espana.jpg';
import benchmarkLlms from '/public/images/pilars/benchmark-llms.jpg';
import roiPymes from '/public/images/pilars/roi-pymes.jpg';

// Get actual PILAR content
const allNews = await getCollection('news');

// Featured PILARs - These are the actual 3 long-form pieces
const featuredPilars = [
  {
    title: "Guía Definitiva IA España 2026",
    wordCount: "13.8K",
    description: "Todo lo que necesitas saber sobre IA en España. Regulación, herramientas, casos reales.",
    href: "/news/guia-definitiva-ia-espana-2026",
    image: guiaIaEspana.src
  },
  {
    title: "Benchmark LLMs Español 2026",
    wordCount: "7.2K",
    description: "15 modelos probados en español. Data real, no marketing. Descubre cuál es mejor para tu caso.",
    href: "/news/benchmark-llms-espanol-2026",
    image: benchmarkLlms.src
  },
  {
    title: "ROI Real IA: 30 Casos PyMEs",
    wordCount: "13.4K",
    description: "Implementaciones reales con números verificados. Qué funciona, qué no, y cuánto cuesta.",
    href: "/news/roi-real-ia-pymes-espanolas-30-casos",
    image: roiPymes.src
  }
];
---

<BaseLayout title="WorkLess - IA en Español con Data Real" description="34,446 palabras de análisis original · 25 tools comparadas · 30 casos ROI documentados. Sin fluff, solo lo que funciona.">
  <Navigation />
  
  <!-- HERO SECTION - Above Fold Conversion Priority -->
  <section id="main-content" class="py-12 md:py-24 lg:py-32 relative overflow-hidden bg-gradient-to-b from-surface to-background">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 to-transparent pointer-events-none"></div>
    
    <div class="container relative">
      <div class="max-w-5xl mx-auto">
        <!-- Main Headline -->
        <div class="text-center mb-8 md:mb-10">
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-heading font-bold mb-4 md:mb-6 leading-[1.1] tracking-tight">
            <span class="block text-primary">Inteligencia Artificial en Español.</span>
            <span class="block text-accent mt-2 md:mt-3">Con Data Real.</span>
          </h1>
          
          <!-- Subheadline with stats -->
          <p class="text-base md:text-xl lg:text-2xl text-text-secondary leading-relaxed max-w-4xl mx-auto px-4">
            <span class="font-semibold text-primary">34,446 palabras de análisis original</span> · 
            <span class="font-semibold text-primary">25 tools comparadas</span> · 
            <span class="font-semibold text-primary">30 casos ROI documentados</span>
            <span class="block mt-2 text-sm md:text-base text-text-tertiary">
              Actualizado 2026 · Sin fluff · Solo lo que funciona
            </span>
          </p>
        </div>
        
        <!-- Newsletter INLINE - First Capture Opportunity -->
        <div class="max-w-2xl mx-auto mb-8 md:mb-10 bg-surface/80 backdrop-blur-sm rounded-2xl p-6 md:p-8 shadow-xl border-2 border-accent/30">
          <div class="text-center mb-5">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent/20 mb-3">
              <span class="text-2xl">📬</span>
            </div>
            <p class="text-base md:text-lg text-text-primary font-medium">
              Análisis semanal + recursos exclusivos. Únete a 10,000+ profesionales.
            </p>
          </div>
          
          <form class="newsletter-form-hero flex flex-col sm:flex-row gap-3" aria-label="Suscripción newsletter">
            <label for="hero-email" class="sr-only">Correo electrónico</label>
            <input 
              id="hero-email"
              type="email" 
              name="email"
              placeholder="tu@email.com" 
              required
              aria-required="true"
              autocomplete="email"
              class="flex-1 px-5 py-4 rounded-lg bg-surface text-text-primary border-2 border-border focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-all text-base md:text-lg"
            />
            <button 
              type="submit" 
              class="btn btn-accent text-base md:text-lg px-8 py-4 whitespace-nowrap font-semibold shadow-lg hover:shadow-xl transition-all hover:scale-[1.02]" 
              aria-label="Acceder gratis"
            >
              Acceder Gratis
            </button>
          </form>
          <p class="text-xs md:text-sm text-text-tertiary text-center mt-3">
            Sin spam · Cancela cuando quieras
          </p>
        </div>
        
        <!-- CTA Secundario -->
        <div class="text-center">
          <a href="#pilars" class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-semibold text-base md:text-lg transition-colors group">
            Ver PILARs
            <svg class="w-5 h-5 group-hover:translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- STATS ROW - Trust Signals Visual -->
  <section class="py-12 md:py-16 bg-surface-variant/30">
    <div class="container">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 max-w-6xl mx-auto">
        <div class="text-center p-6 bg-surface rounded-xl border border-border hover:border-accent/50 transition-colors">
          <div class="text-4xl md:text-5xl mb-3">📊</div>
          <div class="text-2xl md:text-3xl font-bold text-primary mb-1">3 PILARs</div>
