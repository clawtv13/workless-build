---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPosts = sortedNews.slice(0, 3).map(post => ({
  title: post.data.title,
  excerpt: post.data.description,
  href: `/news/${post.id}`,
  date: post.data.date.toLocaleDateString('es-ES'),
  category: "Noticias",
  image: post.data.image
}));

const categories = [
  { 
    title: "Noticias", 
    icon: "📰", 
    description: "Últimas actualizaciones del mundo IA",
    href: "/news",
    color: "from-blue-500 to-cyan-500"
  },
  { 
    title: "Tutoriales", 
    icon: "📚", 
    description: "Guías paso a paso para dominar IA",
    href: "/tutoriales",
    color: "from-purple-500 to-pink-500"
  },
  { 
    title: "Herramientas", 
    icon: "⚙️", 
    description: "Reviews de las mejores tools IA",
    href: "/herramientas",
    color: "from-orange-500 to-red-500"
  },
  { 
    title: "Casos de Uso", 
    icon: "💼", 
    description: "Implementaciones reales exitosas",
    href: "/casos-de-uso",
    color: "from-green-500 to-emerald-500"
  },
];
---

<BaseLayout title="Inicio" description="La fuente definitiva de IA en español">
  <Navigation />
  
  <!-- Hero -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-secondary/10"></div>
    <div class="container relative">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-7xl font-display font-bold mb-6 leading-tight">
          La fuente definitiva de
          <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
            IA en español
          </span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed">
          News, tutoriales, reviews y casos de uso actualizados diariamente
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#featured" class="btn btn-primary text-lg">
            Explorar Contenido
          </a>
          <a href="#newsletter" class="btn btn-secondary text-lg">
            Suscríbete Gratis
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Featured Posts -->
  <section id="featured" class="py-16 bg-dark">
    <div class="container">
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-12">
        📌 Destacados
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredPosts.map(post => (
          <Card {...post} />
        ))}
      </div>
    </div>
  </section>
  
  <!-- Categories -->
  <section class="py-16">
    <div class="container">
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-12 text-center">
        🎯 Explora por Categoría
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {categories.map(cat => (
          <a 
            href={cat.href}
            class="group card hover:scale-105 transition-transform duration-300"
          >
            <div class={`w-16 h-16 rounded-xl bg-gradient-to-br ${cat.color} flex items-center justify-center mb-4 text-3xl group-hover:scale-110 transition-transform`}>
              {cat.icon}
            </div>
            <h3 class="text-xl font-display font-bold mb-2 group-hover:text-primary transition-colors">
              {cat.title}
            </h3>
            <p class="text-gray-400 text-sm">
              {cat.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Newsletter -->
  <section id="newsletter" class="py-20 bg-gradient-to-br from-primary/10 to-secondary/10">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold mb-4">
          📬 Newsletter Semanal
        </h2>
        <p class="text-xl text-gray-300 mb-8">
          Recibe lo mejor de la IA directamente en tu inbox. Sin spam, solo contenido valioso.
        </p>
        <form class="flex flex-col sm:flex-row gap-4">
          <input 
            type="email" 
            placeholder="tu@email.com" 
            required
            class="flex-1 px-6 py-4 rounded-lg bg-dark border border-gray-700 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
          />
          <button type="submit" class="btn btn-primary text-lg whitespace-nowrap">
            Suscribirme Gratis
          </button>
        </form>
        <p class="text-sm text-gray-400 mt-4">
          🔒 Tus datos están seguros. Cancelar cuando quieras.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Stats -->
  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl font-display font-bold text-primary mb-2">500+</div>
          <div class="text-gray-400">Artículos</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-display font-bold text-secondary mb-2">50K+</div>
          <div class="text-gray-400">Lectores/mes</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-display font-bold text-accent mb-2">3-5</div>
          <div class="text-gray-400">Posts/día</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-display font-bold text-primary mb-2">100%</div>
          <div class="text-gray-400">Gratis</div>
        </div>
      </div>
    </div>
  </section>
  
  <Footer />
</BaseLayout>
