</BaseLayout>

<script>
  // Handle all newsletter forms
  const handleNewsletterSubmit = async (e: Event) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    
    if (!emailInput || !submitButton) return;
    
    const email = emailInput.value;
    const originalButtonText = submitButton.textContent;
    
    // Visual feedback
    submitButton.disabled = true;
    submitButton.textContent = 'Suscribiendo...';
    submitButton.classList.add('opacity-70');
    
    try {
      // TODO: Replace with actual email service integration (ConvertKit, Mailchimp, etc.)
      await new Promise(resolve => setTimeout(resolve, 1000));
      
      // Success state
      submitButton.textContent = '✓ ¡Suscrito!';
      submitButton.classList.add('bg-green-600', 'hover:bg-green-700');
      emailInput.value = '';
      
      // Reset after 3 seconds
      setTimeout(() => {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
        submitButton.classList.remove('opacity-70', 'bg-green-600', 'hover:bg-green-700');
      }, 3000);
      
      console.log('Newsletter signup:', email);
      
    } catch (error) {
      submitButton.textContent = 'Error - Inténtalo de nuevo';
      submitButton.classList.add('bg-red-600', 'hover:bg-red-700');
      
      setTimeout(() => {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
        submitButton.classList.remove('opacity-70', 'bg-red-600', 'hover:bg-red-700');
      }, 3000);
      
      console.error('Newsletter signup error:', error);
    }
  };
  
  // Handle lead magnet forms
  const handleLeadMagnetSubmit = async (e: Event) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const magnetId = form.dataset.magnet;
    const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    
    if (!emailInput || !submitButton) return;
    
    const email = emailInput.value;
    const originalButtonText = submitButton.textContent;
    
    submitButton.disabled = true;
    submitButton.textContent = 'Enviando...';
    submitButton.classList.add('opacity-70');
    
    try {
      // TODO: Replace with actual lead magnet delivery system
      await new Promise(resolve => setTimeout(resolve, 1500));
      
      // Success - would normally trigger download or email link
      submitButton.textContent = '✓ Revisa tu email';
      submitButton.classList.add('bg-green-600', 'hover:bg-green-700');
      emailInput.value = '';
      
      setTimeout(() => {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
        submitButton.classList.remove('opacity-70', 'bg-green-600', 'hover:bg-green-700');
      }, 4000);
      
      console.log('Lead magnet request:', magnetId, email);
      
    } catch (error) {
      submitButton.textContent = 'Error - Inténtalo de nuevo';
      submitButton.classList.add('bg-red-600', 'hover:bg-red-700');
      
      setTimeout(() => {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
        submitButton.classList.remove('opacity-70', 'bg-red-600', 'hover:bg-red-700');
      }, 3000);
      
      console.error('Lead magnet error:', error);
    }
  };
  
  // Attach event listeners
  document.querySelectorAll('.newsletter-form-hero, .newsletter-form-bottom').forEach(form => {
    form.addEventListener('submit', handleNewsletterSubmit);
  });
  
  document.querySelectorAll('.lead-magnet-form').forEach(form => {
    form.addEventListener('submit', handleLeadMagnetSubmit);
  });
</script>

