          <div class="text-5xl mb-4">💬</div>
          <h3 class="text-xl md:text-2xl font-heading font-bold mb-3 text-primary">
            Base Datos Prompts
          </h3>
          <p class="text-text-secondary mb-6">
            160 prompts curados para marketing, ventas, legal y más
          </p>
          <a 
            href="/prompts" 
            class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-semibold transition-colors group-hover:gap-3"
          >
            Explorar Prompts →
          </a>
        </div>
        
        <div class="bg-surface rounded-2xl p-8 border border-border hover:border-accent/50 transition-all hover:shadow-xl group">
          <div class="text-5xl mb-4">📊</div>
          <h3 class="text-xl md:text-2xl font-heading font-bold mb-3 text-primary">
            Calculadora ROI IA
          </h3>
          <p class="text-text-secondary mb-6">
            Calcula el retorno real de implementar IA en tu negocio
          </p>
          <a 
            href="/calculadora-roi" 
            class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-semibold transition-colors group-hover:gap-3"
          >
            Calcular Ahora →
          </a>
        </div>
        
        <div class="bg-surface rounded-2xl p-8 border border-border hover:border-accent/50 transition-all hover:shadow-xl group">
          <div class="text-5xl mb-4">🛠️</div>
          <h3 class="text-xl md:text-2xl font-heading font-bold mb-3 text-primary">
            Comparativa 25 Tools
          </h3>
          <p class="text-text-secondary mb-6">
            Filtros interactivos para encontrar la herramienta perfecta
          </p>
          <a 
            href="/herramientas" 
            class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-semibold transition-colors group-hover:gap-3"
          >
            Comparar Tools →
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- LEAD MAGNET SECTION - Email Gate -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-primary/10 to-accent/10">
    <div class="container">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-3xl md:text-5xl font-heading font-bold mb-4 text-primary">
          Descarga Recursos Premium
        </h2>
        <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto">
          Guías y plantillas exclusivas para acelerar tu implementación IA
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <!-- Lead Magnet A: Checklist ROI -->
        <div class="bg-surface rounded-2xl p-8 border-2 border-accent/30 hover:border-accent/50 transition-all hover:shadow-2xl">
          <div class="flex items-start gap-4 mb-6">
