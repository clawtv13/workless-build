        </div>
        
        <div class="text-center p-6 bg-surface rounded-xl border border-border hover:border-accent/50 transition-colors">
          <div class="text-4xl md:text-5xl mb-3">🛠️</div>
          <div class="text-2xl md:text-3xl font-bold text-primary mb-1">25 Tools</div>
          <div class="text-sm text-text-secondary">Comparadas en profundidad</div>
        </div>
        
        <div class="text-center p-6 bg-surface rounded-xl border border-border hover:border-accent/50 transition-colors">
          <div class="text-4xl md:text-5xl mb-3">💬</div>
          <div class="text-2xl md:text-3xl font-bold text-primary mb-1">160 Prompts</div>
          <div class="text-sm text-text-secondary">Curados y testeados</div>
        </div>
        
        <div class="text-center p-6 bg-surface rounded-xl border border-border hover:border-accent/50 transition-colors">
          <div class="text-4xl md:text-5xl mb-3">💰</div>
          <div class="text-2xl md:text-3xl font-bold text-primary mb-1">30 Casos ROI</div>
          <div class="text-sm text-text-secondary">PyMEs españolas reales</div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- FEATURED PILARS - Best Content, Not Latest -->
  <section id="pilars" class="py-16 md:py-20 bg-background scroll-mt-20">
    <div class="container">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-3xl md:text-5xl font-heading font-bold mb-4 text-primary">
          Análisis Definitivos
        </h2>
        <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto">
          Investigación original que no encontrarás en ningún otro sitio
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {featuredPilars.map(pilar => (
          <article class="group bg-surface rounded-2xl overflow-hidden border border-border hover:border-accent/50 transition-all hover:shadow-2xl hover:scale-[1.02]">
            <div class="aspect-video bg-gradient-to-br from-primary/20 to-accent/20 relative overflow-hidden">
