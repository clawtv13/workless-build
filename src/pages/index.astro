              <p class="text-text-secondary mb-4 leading-relaxed">
                {pilar.description}
              </p>
              <a 
                href={pilar.href} 
                class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-semibold transition-colors group/link"
              >
                Leer Análisis
