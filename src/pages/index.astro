  <!-- VALUE PROPS - Why WorkLess vs Generic Blogs -->
  <section class="py-16 md:py-20 bg-background">
    <div class="container">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-3xl md:text-5xl font-heading font-bold mb-4 text-primary">
          Por Qué WorkLess Es Diferente
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
        <div class="text-center p-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent/20 mb-4">
            <span class="text-3xl">✅</span>
          </div>
          <h3 class="text-xl font-heading font-bold mb-2 text-primary">
            Data Original
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            No reescritura ChatGPT. Research verificado.
          </p>
        </div>
        
        <div class="text-center p-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent/20 mb-4">
            <span class="text-3xl">🇪🇸</span>
          </div>
          <h3 class="text-xl font-heading font-bold mb-2 text-primary">
            Casos Españoles
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            PyMEs reales, no ejemplos USA traducidos.
          </p>
        </div>
        
        <div class="text-center p-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent/20 mb-4">
            <span class="text-3xl">🔄</span>
          </div>
          <h3 class="text-xl font-heading font-bold mb-2 text-primary">
            Actualizado 2026
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            No guías obsoletas de 2022.
          </p>
        </div>
        
        <div class="text-center p-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent/20 mb-4">
            <span class="text-3xl">🎯</span>
          </div>
          <h3 class="text-xl font-heading font-bold mb-2 text-primary">
            Sin Fluff
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Directo al grano. Solo lo que funciona.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- NEWSLETTER BOTTOM - Second Opportunity -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-primary to-primary/90 text-primary-fg">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-heading font-bold mb-6">
          Análisis Semanal Directo a Tu Inbox
        </h2>
        
        <p class="text-lg md:text-xl mb-4 text-primary-fg/90">
          Únete a 10,000+ profesionales que reciben:
        </p>
        
        <ul class="text-left max-w-xl mx-auto mb-8 space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
