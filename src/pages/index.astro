            type="email" 
            name="email"
            placeholder="tu@email.com" 
            required
            aria-required="true"
            autocomplete="email"
            class="flex-1 px-6 py-4 rounded-lg bg-surface text-text-primary border-2 border-transparent focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-all text-lg"
          />
          <button 
            type="submit" 
            class="btn btn-accent text-lg px-8 py-4 whitespace-nowrap font-semibold shadow-xl hover:shadow-2xl transition-all hover:scale-[1.02]" 
            aria-label="Suscribirse gratis"
          >
            Suscribirme Gratis
          </button>
        </form>
        
        <div class="flex items-center justify-center gap-6 mt-6 text-sm text-primary-fg/70">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Sin spam
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
