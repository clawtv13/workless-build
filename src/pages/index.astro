---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
import Newsletter from '../components/Newsletter.astro';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPosts = sortedNews.slice(0, 3).map(post => ({
  title: post.data.title,
  excerpt: post.data.description,
  href: `/news/${post.id}`,
  date: post.data.date.toLocaleDateString('es-ES'),
  category: "Noticias",
  image: post.data.image
}));

const categories = [
  { 
    title: "Noticias", 
    icon: "📰", 
    description: "Últimas actualizaciones del mundo IA",
    href: "/news",
    color: "from-blue-500 to-cyan-500"
  },
  { 
    title: "Tutoriales", 
    icon: "📚", 
    description: "Guías paso a paso para dominar IA",
    href: "/tutoriales",
    color: "from-purple-500 to-pink-500"
  },
  { 
    title: "Herramientas", 
    icon: "⚙️", 
    description: "Reviews de las mejores tools IA",
    href: "/herramientas",
    color: "from-orange-500 to-red-500"
  },
  { 
    title: "Casos de Uso", 
    icon: "💼", 
    description: "Implementaciones reales exitosas",
    href: "/casos-de-uso",
    color: "from-green-500 to-emerald-500"
  },
];
---

<BaseLayout title="Inicio" description="La fuente definitiva de IA en español">
  <Navigation />
  
  <!-- Hero -->
  <section id="main-content" class="py-16 md:py-40 relative overflow-hidden">
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 bg-gradient-to-b from-surface-variant/20 to-transparent pointer-events-none"></div>
    
    <div class="container relative">
      <div class="max-w-5xl mx-auto text-center">
        <!-- Main headline - mobile-optimized sizing -->
        <h1 class="text-4xl md:text-6xl lg:text-8xl font-heading font-bold mb-6 md:mb-8 leading-[1.15] tracking-tight">
          <span class="block text-primary">LA Fuente Definitiva de</span>
          <span class="block text-accent mt-1 md:mt-2">Inteligencia Artificial</span>
          <span class="block text-primary mt-1 md:mt-2">en Español</span>
        </h1>
        
        <!-- Authority subheadline -->
        <p class="text-lg md:text-2xl lg:text-3xl font-semibold text-text-primary mb-8 md:mb-12 leading-relaxed px-4">
          Research original · Guías profundas · Recursos exclusivos
        </p>
        
        <!-- Trust signals grid -->
        <div class="max-w-4xl mx-auto mb-8 md:mb-12 bg-surface/80 backdrop-blur-sm rounded-2xl p-6 md:p-8 lg:p-10 shadow-2xl border border-border/50">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 text-left">
            <div class="flex items-start gap-3 md:gap-4">
              <div class="text-accent text-xl md:text-2xl flex-shrink-0 mt-0.5">✓</div>
              <div>
                <div class="font-semibold text-base md:text-lg text-primary">30,000+ palabras de research verificado</div>
                <div class="text-text-secondary text-sm mt-0.5 md:mt-1">Análisis profundos y documentados</div>
              </div>
            </div>
            
            <div class="flex items-start gap-3 md:gap-4">
              <div class="text-accent text-xl md:text-2xl flex-shrink-0 mt-0.5">✓</div>
              <div>
                <div class="font-semibold text-base md:text-lg text-primary">Benchmarks originales de 15+ LLMs</div>
                <div class="text-text-secondary text-sm mt-0.5 md:mt-1">Probados específicamente en español</div>
              </div>
            </div>
            
            <div class="flex items-start gap-3 md:gap-4">
              <div class="text-accent text-xl md:text-2xl flex-shrink-0 mt-0.5">✓</div>
              <div>
                <div class="font-semibold text-base md:text-lg text-primary">500+ prompts curados por expertos</div>
                <div class="text-text-secondary text-sm mt-0.5 md:mt-1">Listos para usar en tu negocio</div>
              </div>
            </div>
            
            <div class="flex items-start gap-3 md:gap-4">
              <div class="text-accent text-xl md:text-2xl flex-shrink-0 mt-0.5">✓</div>
              <div>
                <div class="font-semibold text-base md:text-lg text-primary">Casos de estudio reales de PyMEs españolas</div>
                <div class="text-text-secondary text-sm mt-0.5 md:mt-1">Implementaciones verificadas y medibles</div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- CTA buttons - primary and secondary -->
        <div class="flex flex-col sm:flex-row gap-3 md:gap-4 justify-center items-stretch sm:items-center px-4">
          <a href="#featured" class="btn btn-accent text-base md:text-lg px-6 md:px-8 py-3 md:py-4 font-semibold shadow-xl hover:shadow-2xl transition-all text-center">
            Accede a Recursos Exclusivos
          </a>
          <a href="/news" class="btn btn-secondary text-base md:text-lg px-6 md:px-8 py-3 md:py-4 font-semibold text-center">
            Ver Research Original
          </a>
        </div>
        
        <!-- Social proof indicator -->
        <p class="text-text-secondary mt-8 text-sm">
          Confiado por más de 50,000 profesionales cada mes
        </p>
      </div>
    </div>
  </section>
  
  <!-- Featured Posts -->
  <section id="featured" class="py-16 bg-surface" aria-labelledby="featured-heading">
    <div class="container">
      <h2 id="featured-heading" class="text-3xl md:text-4xl font-heading font-semibold mb-12 text-primary">
        Destacados
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" role="list">
        {featuredPosts.map(post => (
          <div role="listitem">
            <Card {...post} />
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Categories -->
  <section class="py-16 bg-surface-variant/30" aria-labelledby="categories-heading">
    <div class="container">
      <h2 id="categories-heading" class="text-3xl md:text-4xl font-heading font-semibold mb-12 text-center text-primary">
        Explora por Categoría
      </h2>
      <nav class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" aria-label="Categorías de contenido">
        {categories.map(cat => (
          <a 
            href={cat.href}
            class="group card hover:scale-[1.02] transition-all duration-200"
          >
            <div class="w-16 h-16 rounded-xl bg-accent/10 flex items-center justify-center mb-4 text-3xl group-hover:bg-accent/20 transition-colors">
              {cat.icon}
            </div>
            <h3 class="text-xl font-heading font-semibold mb-2 group-hover:text-accent transition-colors">
              {cat.title}
            </h3>
            <p class="text-text-secondary text-sm">
              {cat.description}
            </p>
          </a>
        ))}
      </nav>
    </div>
  </section>
  
  <!-- Newsletter -->
  <Newsletter 
    variant="default" 
    headline="No te pierdas nada" 
    description="Noticias de IA semanales + recursos exclusivos directamente en tu bandeja" 
  />
  
  <!-- Stats -->
  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl font-display font-bold text-primary mb-2">500+</div>
          <div class="text-gray-400">Artículos</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-display font-bold text-secondary mb-2">50K+</div>
          <div class="text-gray-400">Lectores/mes</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-display font-bold text-accent mb-2">3-5</div>
          <div class="text-gray-400">Posts/día</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-display font-bold text-primary mb-2">100%</div>
          <div class="text-gray-400">Gratis</div>
        </div>
      </div>
    </div>
  </section>
  
  <Footer />
</BaseLayout>
