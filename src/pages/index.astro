              />
              <button 
                type="submit" 
                class="btn btn-accent px-6 py-3 whitespace-nowrap font-semibold" 
                aria-label="Descargar gratis"
              >
                Descargar Gratis
              </button>
            </div>
          </form>
        </div>
        
        <!-- Lead Magnet B: 50 Prompts Avanzados -->
        <div class="bg-surface rounded-2xl p-8 border-2 border-accent/30 hover:border-accent/50 transition-all hover:shadow-2xl">
          <div class="flex items-start gap-4 mb-6">
            <div class="text-5xl flex-shrink-0">🎯</div>
            <div>
              <div class="inline-block bg-accent/20 text-accent px-3 py-1 rounded-full text-xs font-bold mb-3">
                PDF · 50 prompts
              </div>
              <h3 class="text-xl md:text-2xl font-heading font-bold mb-2 text-primary">
                50 Prompts Avanzados
              </h3>
              <p class="text-text-secondary">
                Prompts probados para marketing, legal, ventas y más
              </p>
            </div>
          </div>
          
          <form class="lead-magnet-form" data-magnet="prompts-avanzados" aria-label="Descargar prompts">
            <label for="email-prompts" class="sr-only">Correo electrónico</label>
            <div class="flex flex-col sm:flex-row gap-3">
              <input 
                id="email-prompts"
                type="email" 
                name="email"
                placeholder="tu@email.com" 
                required
                aria-required="true"
                autocomplete="email"
                class="flex-1 px-4 py-3 rounded-lg bg-background text-text-primary border-2 border-border focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-all"
              />
              <button 
                type="submit" 
                class="btn btn-accent px-6 py-3 whitespace-nowrap font-semibold" 
                aria-label="Descargar gratis"
              >
                Descargar Gratis
              </button>
            </div>
          </form>
        </div>
      </div>
