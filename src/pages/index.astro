                Checklist ROI IA PyMEs
              </h3>
              <p class="text-text-secondary">
                Guía paso a paso para evaluar implementación IA en tu negocio
              </p>
            </div>
          </div>
          
          <form class="lead-magnet-form" data-magnet="checklist-roi" aria-label="Descargar checklist">
            <label for="email-checklist" class="sr-only">Correo electrónico</label>
            <div class="flex flex-col sm:flex-row gap-3">
              <input 
                id="email-checklist"
                type="email" 
                name="email"
                placeholder="tu@email.com" 
                required
