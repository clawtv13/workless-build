---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout 
  title={post.data.title} 
  description={post.data.description}
  image={post.data.image}
>
  <Navigation />
  
  <main class="py-8 md:py-12">
    <div class="container">
      <!-- Article Header -->
      <header class="max-w-3xl mx-auto mb-8">
        <div class="flex items-center gap-3 mb-4 text-sm">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-accent/10 text-accent">
            {post.data.category || 'Noticias'}
          </span>
          <time class="text-text-tertiary" datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('es-ES', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </time>
        </div>
        
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-semibold mb-4 text-primary leading-tight">
          {post.data.title}
        </h1>
        
        {post.data.description && (
          <p class="text-lg md:text-xl text-text-secondary leading-relaxed">
            {post.data.description}
          </p>
        )}
      </header>
      
      <!-- Article Content -->
      <article class="max-w-3xl mx-auto">
        <div class="article-content">
          <Content />
        </div>
        
        <!-- Source Link -->
        {post.data.sourceUrl && (
          <div class="mt-10 p-5 bg-surface-variant rounded-lg border border-border">
            <p class="text-sm text-text-secondary mb-2">Fuente original:</p>
            <a 
              href={post.data.sourceUrl} 
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:text-accent-hover transition-colors font-medium"
            >
              {post.data.source || 'Ver artículo original'} →
            </a>
          </div>
        )}
        
        <!-- Back Link -->
        <div class="mt-10 pt-8 border-t border-border">
          <a 
            href="/news" 
            class="inline-flex items-center text-accent hover:text-accent-hover transition-colors font-medium no-underline"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Volver a Noticias
          </a>
        </div>
      </article>
    </div>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  /* Professional article typography */
  .article-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #09090B;
  }
  
  /* Headings */
  .article-content :global(h2) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: #18181B;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #E4E4E7;
  }
  
  .article-content :global(h3) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.375rem;
    font-weight: 600;
    color: #18181B;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  
  /* Paragraphs */
  .article-content :global(p) {
    margin-bottom: 1.25rem;
  }
  
  /* Strong text */
  .article-content :global(strong) {
    font-weight: 700;
    color: #18181B;
  }
  
  /* Links */
  .article-content :global(a) {
    color: #EC4899;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  
  .article-content :global(a:hover) {
    color: #DB2777;
    border-bottom-color: currentColor;
  }
  
  /* Lists */
  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
  }
  
  .article-content :global(ul) {
    list-style-type: disc;
  }
  
  .article-content :global(ol) {
    list-style-type: decimal;
  }
  
  .article-content :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }
  
  .article-content :global(li::marker) {
    color: #EC4899;
  }
  
  /* Blockquotes */
  .article-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid #EC4899;
    background-color: rgba(236, 72, 153, 0.05);
    font-style: italic;
    color: #3F3F46;
  }
  
  .article-content :global(blockquote p) {
    margin-bottom: 0;
  }
  
  /* Horizontal rules */
  .article-content :global(hr) {
    margin: 2rem 0;
    border: none;
    border-top: 1px solid #E4E4E7;
  }
  
  /* Code */
  .article-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    background-color: rgba(236, 72, 153, 0.1);
    color: #EC4899;
    border-radius: 0.25rem;
  }
  
  .article-content :global(pre) {
    margin: 1.5rem 0;
    padding: 1.25rem;
    background-color: #E8ECF0;
    border: 1px solid #E4E4E7;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
  
  .article-content :global(pre code) {
    padding: 0;
    background: none;
    color: #18181B;
  }
  
  /* Tables */
  .article-content :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  
  .article-content :global(th),
  .article-content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid #E4E4E7;
    text-align: left;
  }
  
  .article-content :global(th) {
    background-color: #E8ECF0;
    font-weight: 600;
    color: #18181B;
  }
  
  .article-content :global(tr:nth-child(even)) {
    background-color: rgba(232, 236, 240, 0.3);
  }
  
  /* Emphasis */
  .article-content :global(em) {
    font-style: italic;
    color: #3F3F46;
  }
  
  /* Images */
  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: 0.5rem;
  }
</style>
