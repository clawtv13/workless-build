---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Página No Encontrada" description="La página que buscas no existe">
  <Navigation />
  
  <main class="py-20 min-h-[60vh] flex items-center">
    <div class="container text-center">
      <h1 class="text-9xl font-display font-bold text-primary mb-4">404</h1>
      <h2 class="text-3xl font-display font-bold mb-4">Página No Encontrada</h2>
      <p class="text-xl text-gray-400 mb-8">
        Lo sentimos, la página que buscas no existe o ha sido movida.
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/" class="btn btn-primary">
          Volver al Inicio
        </a>
        <a href="/news" class="btn btn-secondary">
          Ver Noticias
        </a>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
