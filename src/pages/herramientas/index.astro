---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Card from '../../components/Card.astro';

const allTools = await getCollection('herramientas');
const sortedTools = allTools.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Herramientas IA" description="Comparativas y reviews de herramientas de Inteligencia Artificial">
  <Navigation />
  
  <main class="py-12">
    <div class="container">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-heading font-semibold mb-4 text-primary">Herramientas IA</h1>
        <p class="text-xl text-text-secondary">
          Comparativas y reviews de herramientas de Inteligencia Artificial
        </p>
      </div>
      
      <!-- Tools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedTools.map(post => (
          <Card
            title={post.data.title}
            excerpt={post.data.description}
            href={`/herramientas/${post.id}`}
            date={post.data.date.toLocaleDateString('es-ES')}
            category="Herramientas"
            image={post.data.image}
          />
        ))}
      </div>
      
      {sortedTools.length === 0 && (
        <div class="text-center py-20">
          <p class="text-gray-400 text-lg mb-4">
            Próximamente: reviews detalladas de herramientas IA. Suscríbete para no perdértelo.
          </p>
          <a href="/#newsletter" class="btn btn-primary">
            Suscribirse
          </a>
        </div>
      )}
    </div>
  </main>
  
  <Footer />
</BaseLayout>
